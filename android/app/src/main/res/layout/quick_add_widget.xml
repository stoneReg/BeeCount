<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Widget content" />

    <!-- 跳过标题区 ~18%,下方 2×2 / 2×4 网格点击(与 QuickAddView 对齐) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="41"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/click_cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="41"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/click_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/click_cell_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
